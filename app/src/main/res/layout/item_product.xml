<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_8"
    android:layout_marginVertical="@dimen/space_4"
    style="@style/Widget.StockEase.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/product_name_fallback"
                android:textAppearance="@style/TextAppearance.StockEase.Section" />

            <TextView
                android:id="@+id/tvProductPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/product_price_fallback"
                android:textAppearance="@style/TextAppearance.StockEase.Title"
                android:textColor="@color/primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProductCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/product_name_fallback"
                android:textAppearance="@style/TextAppearance.StockEase.Body" />

            <TextView
                android:id="@+id/tvProductQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_header"
                android:paddingHorizontal="@dimen/space_12"
                android:paddingVertical="@dimen/space_4"
                android:text="@string/product_stock_fallback"
                android:textAppearance="@style/TextAppearance.StockEase.Label"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvProductLowStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_amber"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="LOW STOCK"
                android:textAllCaps="false"
                android:textColor="@color/warning_text"
                android:textStyle="bold"
                android:visibility="gone"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProductCost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/product_price_fallback"
                android:textAppearance="@style/TextAppearance.StockEase.Caption" />

            <TextView
                android:id="@+id/tvProductProfit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/product_price_fallback"
                android:textAppearance="@style/TextAppearance.StockEase.Label"
                android:textColor="@color/profit" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvProductBarcode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/product_name_fallback"
            android:textAppearance="@style/TextAppearance.StockEase.Caption" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
