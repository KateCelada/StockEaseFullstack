<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F8FAFC">

    <!-- Left Enterprise Navigation Sidebar -->
    <LinearLayout
        android:layout_width="230dp"
        android:layout_height="match_parent"
        android:background="#0F172A"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <!-- App Brand Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_btn_primary"
                android:text="S"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="StockEase"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SECTION: OVERVIEW -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OVERVIEW"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/navAuditDashboard"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_nav_dashboard"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- SECTION: MANAGEMENT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MANAGEMENT"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/navAuditStores"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="2dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_nav_stores"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stores"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAuditUsers"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="2dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_nav_users"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Users"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAuditAdmins"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_nav_admins"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Store Admins"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- SECTION: ANALYTICS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANALYTICS"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/navAuditReports"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="2dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_nav_reports"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reports"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Active Menu Item: Audit Logs -->
        <LinearLayout
            android:id="@+id/navAuditAuditLogs"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="#1E293B"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_nav_inventory"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audit Logs"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SECTION: SYSTEM -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/navAuditSettings"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_nav_settings"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom User Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="10dp"
            android:background="#1E293B"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvAuditAvatarInitials"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:text="SA"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAuditProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System Super Admin"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Super Administrator"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAuditLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_nav_logout"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log out"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Main Workspace Area -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Page Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audit Logs"
                        android:textColor="#0F172A"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Review administrative events, security actions, and operational audit trail"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnAuditRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Refresh"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@color/primary"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="0dp" />
            </LinearLayout>

            <!-- Filters & Search Toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <!-- Search Input Container -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_search"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/etAuditSearch"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Search by user, action, target, or store..."
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:imeOptions="actionSearch" />
                </LinearLayout>

                <!-- Filter Spinner -->
                <Spinner
                    android:id="@+id/spinnerAuditActionFilter"
                    android:layout_width="180dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>

            <!-- Date Filter Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date Filter:"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <Button
                    android:id="@+id/btnAuditFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="All"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2563EB"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnAuditFilterToday"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Today"
                    android:textSize="11sp"
                    android:textColor="#475569"
                    android:backgroundTint="#E2E8F0"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnAuditFilterWeek"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="This Week"
                    android:textSize="11sp"
                    android:textColor="#475569"
                    android:backgroundTint="#E2E8F0"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnAuditFilterMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="This Month"
                    android:textSize="11sp"
                    android:textColor="#475569"
                    android:backgroundTint="#E2E8F0"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnAuditFilterCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Custom 📅"
                    android:textSize="11sp"
                    android:textColor="#475569"
                    android:backgroundTint="#E2E8F0"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp" />
            </LinearLayout>

            <!-- Audit Logs Data Table Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Table Header (44dp height) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:paddingHorizontal="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="#F8FAFC">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:text="DATE &amp; TIME"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:text="USER"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:text="ROLE"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:text="ACTION"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="STORE / SCOPE"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2.6"
                        android:text="DETAILS"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />

                <!-- Status / Empty Indicator -->
                <TextView
                    android:id="@+id/tvAuditLogsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading audit logs..."
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone" />

                <!-- Dynamic Audit Rows -->
                <LinearLayout
                    android:id="@+id/llAuditLogRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
