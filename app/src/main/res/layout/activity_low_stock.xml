<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/app_background">

    <!-- Persistent navigation (shared across all main screens) -->
    <include layout="@layout/view_sidebar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

    <!-- Top Action / Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLowStockBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Back"
            android:textColor="@color/text_primary"

            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:layout_marginEnd="16dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restock Intelligence &amp; Suggestions"
                android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Replenishment recommendations based on 30-unit par levels"
                android:textColor="@color/text_secondary"

                android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Summary Metric Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Card 1: Total Items to Reorder -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/card_background"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Items to Reorder"
                        android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:id="@+id/tvRestockTotalItems"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_primary"


                        android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Title" />
                </LinearLayout>

                <!-- Card 2: Critical Urgency (<5) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/card_background"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Critical Stock (&lt; 5)"
                        android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:id="@+id/tvRestockCriticalItems"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/danger_strong"


                        android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Title" />
                </LinearLayout>

                <!-- Card 3: Est Capital Required -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/card_background"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Est. Restock Cost"
                        android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:id="@+id/tvRestockTotalEstCost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱0.00"
                        android:textColor="@color/brand_accent"


                        android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Title" />
                </LinearLayout>
            </LinearLayout>

            <!-- Intelligence Formula Callout Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/purple_bg"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
  android:textAppearance="@style/TextAppearance.StockEase.Body" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="StockEase Reorder Formula: Suggested = max(0, Par Level [30] - Current Stock). Est. Cost = Suggested × Unit Price."
                    android:textColor="@color/purple_text"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />
            </LinearLayout>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutRestockEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/card_background"
                android:padding="48dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""

                    android:layout_marginBottom="12dp"  android:textAppearance="@style/TextAppearance.StockEase.Display" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Inventory Levels Healthy"
                    android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No products in this store are currently below the low stock threshold."
                    android:textColor="@color/text_secondary"

                    android:layout_marginTop="4dp"
                    android:gravity="center"  android:textAppearance="@style/TextAppearance.StockEase.Body" />
            </LinearLayout>

            <!-- RecyclerView of Suggestions -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLowStockProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>
    </LinearLayout>

</LinearLayout>