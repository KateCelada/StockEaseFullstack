<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Paper Receipt Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Store Header -->
        <TextView
            android:id="@+id/tvStoreHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="STOCKEASE POS SYSTEM\nStore #001 - Main Branch\n123 Retail Ave, Commercial Center\nTEL: (02) 8888-0000"
            android:textColor="#000000"
            android:textSize="12sp" />

        <!-- Top Dashed Line -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="------------------------------------------"
            android:textColor="#000000"
            android:textSize="12sp" />

        <!-- Transaction Details -->
        <TextView
            android:id="@+id/tvReceiptTxId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="TRANS #: 000000"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReceiptDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="DATE   : 2026-09-23 08:43:00"
            android:textColor="#000000"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvCashier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="CASHIER: Staff #01"
            android:textColor="#000000"
            android:textSize="12sp" />

        <!-- Middle Dashed Line -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="------------------------------------------"
            android:textColor="#000000"
            android:textSize="12sp" />

        <!-- Itemized List Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="QTY  ITEM DESCRIPTION             PRICE"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="- - - - - - - - - - - - - - - - - - - - -"
            android:textColor="#000000"
            android:textSize="12sp" />

        <!-- Purchased Items List -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvReceiptItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:text="1x Colgate Toothpaste         ₱45.00\n1x Fresh Milk 1L              ₱95.00"
                android:textColor="#000000"
                android:textSize="12sp" />
        </ScrollView>

        <!-- Bottom Dashed Line -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="------------------------------------------"
            android:textColor="#000000"
            android:textSize="12sp" />

        <!-- Total Breakdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="TOTAL AMOUNT:"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReceiptTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="₱140.00"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="PAYMENT TYPE:"
                android:textColor="#000000"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="CASH"
                android:textColor="#000000"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Receipt Footer / Barcode Visual -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="=========================================="
            android:textColor="#000000"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="||| | |||| | |||||| || | |||| ||| ||"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="THANK YOU FOR SHOPPING!\nPLEASE COME AGAIN"
            android:textColor="#000000"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnVoidFromReceipt"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#DC2626"
            android:text="Void Transaction"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnNewSale"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#000000"
            android:text="New Sale"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>