<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="24dp">

    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true">

            <TextView
                android:id="@+id/tvStoresTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Store Management"
                android:textColor="#0F172A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStoresSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View and register store branches"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAddStore"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ Add Store"
            android:textSize="12sp"
            android:backgroundTint="@color/primary"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:paddingVertical="0dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- Stores List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStores"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
