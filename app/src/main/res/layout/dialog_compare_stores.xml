<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚖ Store Comparison Tool"
            android:textColor="#1B1C30"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select two branch stores to compare performance side-by-side"
            android:textColor="#6E7191"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <!-- Store Selection Dropdowns -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Branch Store A"
                    android:textColor="#7C4DFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerCompareStoreA"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#F5F6FA"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Branch Store B"
                    android:textColor="#2E7D32"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerCompareStoreB"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#F5F6FA"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Comparison Table Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B1C30"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="METRIC"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCompareColA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="STORE A"
                android:textColor="#D1C4E9"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCompareColB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="STORE B"
                android:textColor="#C8E6C9"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Metric Row 1: Today's Sales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:background="#FFFFFF"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="Today's Sales"
                android:textColor="#1B1C30"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCompareSalesA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="₱0.00"
                android:textColor="#1B1C30"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCompareSalesB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="₱0.00"
                android:textColor="#1B1C30"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EFEFF6" />

        <!-- Metric Row 2: Transactions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:background="#FFFFFF"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="Transactions"
                android:textColor="#1B1C30"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCompareTxA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0"
                android:textColor="#1B1C30"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCompareTxB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0"
                android:textColor="#1B1C30"
                android:textSize="13sp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EFEFF6" />

        <!-- Metric Row 3: Average Basket Size -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:background="#FFFFFF"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="Avg Basket"
                android:textColor="#1B1C30"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCompareAvgA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="₱0.00"
                android:textColor="#1B1C30"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCompareAvgB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="₱0.00"
                android:textColor="#1B1C30"
                android:textSize="13sp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EFEFF6" />

        <!-- Metric Row 4: Assigned Staff -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:background="#FFFFFF"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="Assigned Staff"
                android:textColor="#1B1C30"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCompareStaffA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0"
                android:textColor="#1B1C30"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCompareStaffB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0"
                android:textColor="#1B1C30"
                android:textSize="13sp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EFEFF6" />

        <!-- Metric Row 5: Location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:background="#FFFFFF"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="Location"
                android:textColor="#1B1C30"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCompareLocA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="—"
                android:textColor="#6E7191"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvCompareLocB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="—"
                android:textColor="#6E7191"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCompareClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Close"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7C4DFF" />

    </LinearLayout>
</ScrollView>
