<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="horizontal">

    <!-- Left Navigation Sidebar -->
    <LinearLayout
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:background="@color/sidebar_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="StockEase"
            android:textColor="@color/white"
android:textAppearance="@style/TextAppearance.StockEase.Title" />

        <!-- SECTION HEADER: OVERVIEW -->
        <LinearLayout
            android:id="@+id/navHeaderOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OVERVIEW"
                android:letterSpacing="0.08"
                android:textColor="@color/sidebar_text"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />

            <TextView
                android:id="@+id/navArrowOverview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sidebar_text"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSectionOverviewItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/navDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="⊞ Dashboard"
            android:textColor="@color/sidebar_text"
android:textAppearance="@style/TextAppearance.StockEase.Body" />
        </LinearLayout>

        <!-- SECTION HEADER: MANAGEMENT -->
        <LinearLayout
            android:id="@+id/navHeaderManagement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MANAGEMENT"
                android:letterSpacing="0.08"
                android:textColor="@color/sidebar_text"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />

            <TextView
                android:id="@+id/navArrowManagement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sidebar_text"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSectionManagementItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/navPos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="POS/Sales"
            android:textColor="@color/sidebar_text"
android:textAppearance="@style/TextAppearance.StockEase.Body" />

        <TextView
            android:id="@+id/navInventory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Inventory"
            android:textColor="@color/sidebar_text"
android:textAppearance="@style/TextAppearance.StockEase.Body" />
        </LinearLayout>

        <!-- SECTION HEADER: ANALYTICS -->
        <LinearLayout
            android:id="@+id/navHeaderAnalytics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ANALYTICS"
                android:letterSpacing="0.08"
                android:textColor="@color/sidebar_text"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />

            <TextView
                android:id="@+id/navArrowAnalytics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sidebar_text"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSectionAnalyticsItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/navTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Transactions"
                android:textColor="@color/sidebar_text"
android:textAppearance="@style/TextAppearance.StockEase.Body" />
        </LinearLayout>

        <!-- SECTION HEADER: SYSTEM -->
        <LinearLayout
            android:id="@+id/navHeaderSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SYSTEM"
                android:letterSpacing="0.08"
                android:textColor="@color/sidebar_text"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />

            <TextView
                android:id="@+id/navArrowSystem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sidebar_text"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSectionSystemItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/navSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Settings"
                android:textColor="@color/sidebar_text"
android:textAppearance="@style/TextAppearance.StockEase.Body" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/sidebar_divider" />

        <TextView
            android:id="@+id/navLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Log out"
            android:textColor="@color/sidebar_text"
android:textAppearance="@style/TextAppearance.StockEase.Body"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textColor="@color/text_primary"
android:textAppearance="@style/TextAppearance.StockEase.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Check your personal information."
                    android:textColor="@color/text_secondary"
android:textAppearance="@style/TextAppearance.StockEase.Label" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnNotification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text=""
android:textAppearance="@style/TextAppearance.StockEase.Section" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReturn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:paddingHorizontal="16dp"
                    android:text="Return"
                    android:textColor="@color/white"
android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Secondary" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Profile Content Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Left Profile Detail Card -->
            <ScrollView
                android:layout_width="260dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:background="@color/card_background"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/cardProfileDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!-- Edit Action Button -->
                    <TextView
                        android:id="@+id/btnEditProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="Edit"
                        android:textColor="@color/text_secondary"
android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <!-- Avatar Circle -->
                    <TextView
                        android:id="@+id/tvAvatar"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/primary"
                        android:gravity="center"
                        android:text="H"
                        android:textColor="@color/white"
android:textAppearance="@style/TextAppearance.StockEase.Display" />

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hilbert Cage"
                        android:textColor="@color/text_primary"
android:textAppearance="@style/TextAppearance.StockEase.Section" />

                    <TextView
                        android:id="@+id/tvRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Staff"
                        android:textColor="@color/text_muted"
android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/card_subtle_bg" />

                    <!-- Contact Details Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text=""
android:textAppearance="@style/TextAppearance.StockEase.Label" />

                        <TextView
                            android:id="@+id/tvAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="123 Main Sreet, Cebu"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text=""
android:textAppearance="@style/TextAppearance.StockEase.Label" />

                        <TextView
                            android:id="@+id/tvEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="person@gmail.com"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text=""
android:textAppearance="@style/TextAppearance.StockEase.Label" />

                        <TextView
                            android:id="@+id/tvPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="09607420192"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OCCUPATION"
                        android:textColor="@color/text_muted"
                        android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Caption" />

                    <TextView
                        android:id="@+id/tvOccupation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Cashier"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/card_subtle_bg" />

                    <!-- Additional Details -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text=""
android:textAppearance="@style/TextAppearance.StockEase.Label" />

                        <TextView
                            android:id="@+id/tvSex"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sex: Male"
                            android:textColor="@color/text_secondary"
android:textAppearance="@style/TextAppearance.StockEase.Label" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text=""
android:textAppearance="@style/TextAppearance.StockEase.Label" />

                        <TextView
                            android:id="@+id/tvBranch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Southern Branch"
                            android:textColor="@color/text_secondary"
android:textAppearance="@style/TextAppearance.StockEase.Label" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvIdNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID: 25-2532-3445"
                        android:textColor="@color/text_secondary"
android:textAppearance="@style/TextAppearance.StockEase.Label" />
                </LinearLayout>
            </ScrollView>

            <!-- Right Content Container -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/card_background"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>