<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Change Password"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your current password and choose a new one (minimum 6 characters)."
        android:textSize="12sp"
        android:textColor="#64748B"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Password"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#475569"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etCurrentPassword"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_input_field"
        android:hint="Enter current password"
        android:textColorHint="#94A3B8"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Password"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#475569"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etNewPassword"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_input_field"
        android:hint="Enter new password (min. 6 chars)"
        android:textColorHint="#94A3B8"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm New Password"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#475569"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_input_field"
        android:hint="Re-type new password"
        android:textColorHint="#94A3B8"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelPassword"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Cancel"
            style="?attr/borderlessButtonStyle"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSubmitPassword"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Update Password"
            android:background="#2563EB"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingHorizontal="16dp" />
    </LinearLayout>
</LinearLayout>
