<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/card_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Shift Summary"
        android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Title" />

    <TextView
        android:id="@+id/tvDialogStaffStore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Staff: — • Store: —"
        android:textColor="@color/text_secondary"

        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_background"
        android:layout_marginBottom="16dp" />

    <!-- Total Sales Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_background"
        android:padding="16dp"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Shift Sales"
            android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

        <TextView
            android:id="@+id/tvDialogTotalSales"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱0.00"
            android:textColor="@color/success_text"


            android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Display" />

        <TextView
            android:id="@+id/tvDialogTxCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 transactions processed"
            android:textColor="@color/text_secondary"

            android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
    </LinearLayout>

    <!-- Cash Breakdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cash in Drawer"
            android:textColor="@color/text_primary"

            android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Body" />

        <TextView
            android:id="@+id/tvDialogCashSales"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱0.00"
            android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Section" />
    </LinearLayout>

    <!-- GCash Breakdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GCash / Digital"
            android:textColor="@color/text_primary"

            android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Body" />

        <TextView
            android:id="@+id/tvDialogGcashSales"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱0.00"
            android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Section" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_background"
        android:layout_marginBottom="12dp" />

    <!-- First & Last Sale Times -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="First Sale Today"
            android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

        <TextView
            android:id="@+id/tvDialogFirstSale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/text_primary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Last Sale Today"
            android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

        <TextView
            android:id="@+id/tvDialogLastSale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/text_primary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Done"
        android:textColor="@color/white"  style="@style/Widget.StockEase.Button.Primary" />

</LinearLayout>
