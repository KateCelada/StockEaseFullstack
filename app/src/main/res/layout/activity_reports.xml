<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReportsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Store Reports"
                    android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Title" />

                <TextView
                    android:id="@+id/tvReportsSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Summarized store performance &amp; sales analytics"
                    android:textColor="@color/text_secondary"

                    android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Body" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton style="@style/Widget.StockEase.Button.Secondary"
                android:id="@+id/btnReportsBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back" />
        </LinearLayout>

        <!-- Date Range Filter Buttons -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterToday"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:text="Today"

                    android:textColor="@color/white"  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterThisWeek"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:text="This Week"

                    android:textColor="@color/white"  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterThisMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:text="This Month"

                    android:textColor="@color/white"  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Custom Range"

                    android:textColor="@color/white"  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Secondary" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Active Filter Indicator -->
        <TextView
            android:id="@+id/tvActiveDateRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Period: Today"
            android:textColor="@color/brand_accent"

            android:textStyle="bold"
            android:layout_marginBottom="16dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

        <!-- 4 Summary Metric Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Card 1: Total Sales -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/card_background"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Sales"
                    android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                <TextView
                    android:id="@+id/tvReportTotalSales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱0.00"


                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Title" />
            </LinearLayout>

            <!-- Card 2: Transactions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/card_background"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transactions"
                    android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                <TextView
                    android:id="@+id/tvReportTotalTransactions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"


                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Title" />
            </LinearLayout>

            <!-- Card 3: Average Transaction -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/card_background"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avg Transaction"
                    android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                <TextView
                    android:id="@+id/tvReportAvgTransaction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱0.00"


                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Title" />
            </LinearLayout>

            <!-- Card 4: Products Sold -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/card_background"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Products Sold"
                    android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                <TextView
                    android:id="@+id/tvReportProductsSold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"


                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Title" />
            </LinearLayout>
        </LinearLayout>

        <!-- Two Column Section: Payment Method & Top Products -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Left: Sales by Payment Method -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/card_background"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sales by Payment Method"
                    android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Section" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distribution of payment options"
                    android:textColor="@color/text_secondary"

                    android:layout_marginBottom="12dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                <LinearLayout
                    android:id="@+id/llPaymentMethodsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Right: Top Selling Products -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:background="@color/card_background"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top Selling Products"
                    android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Section" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Highest volume items sold"
                    android:textColor="@color/text_secondary"

                    android:layout_marginBottom="12dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                <LinearLayout
                    android:id="@+id/llTopProductsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Section: Daily / Recent Sales Breakdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Sales Breakdown"
                android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Section" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent revenue history by date"
                android:textColor="@color/text_secondary"

                android:layout_marginBottom="12dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

            <!-- Daily Table Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/app_background"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:text="DATE"
                    android:textColor="@color/text_secondary"

                    android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="SALES"
                    android:textColor="@color/text_secondary"

                    android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="TRANSACTIONS"
                    android:textColor="@color/text_secondary"

                    android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llDailySalesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
