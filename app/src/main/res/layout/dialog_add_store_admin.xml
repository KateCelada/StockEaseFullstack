<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Register Store Admin"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etAdminFullName"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_input_field"
        android:hint="Full Name"
        android:textColorHint="#94A3B8"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:inputType="textPersonName"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etAdminUsername"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_input_field"
        android:hint="Username"
        android:textColorHint="#94A3B8"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etAdminPassword"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_input_field"
        android:hint="Password"
        android:textColorHint="#94A3B8"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Assign to Store Branch:"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spAssignStore"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelAdmin"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Cancel"
            style="?attr/borderlessButtonStyle"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSaveAdmin"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Create Account"
            android:textSize="13sp"
            android:backgroundTint="@color/primary"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>