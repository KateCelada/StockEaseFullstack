<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/app_background">

    <!-- Persistent navigation (shared across all main screens) -->
    <include layout="@layout/view_sidebar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/sidebar_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnTransfersBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="Back"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock Transfers"
                android:textColor="@color/white"

  android:textAppearance="@style/TextAppearance.StockEase.Section" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Multi-store inventory movement and tracking"
                android:textColor="@color/text_muted"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleNewTransfer"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="+ New Transfer"

            android:textColor="@color/white"
            android:paddingHorizontal="16dp"
            android:paddingVertical="0dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- New Transfer Card (Collapsible) -->
            <LinearLayout
                android:id="@+id/cardNewTransfer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEW STOCK TRANSFER"
                    android:textColor="@color/text_secondary"

                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                <!-- From & To Stores Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:id="@+id/llFromStoreColumn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:id="@+id/tvFromStoreLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="From Store (Source)"
                            android:textColor="@color/text_primary"

                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                        <Spinner
                            android:id="@+id/spFromStore"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_input_field"
                            android:paddingHorizontal="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvToStoreLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="To Store (Destination)"
                            android:textColor="@color/text_primary"

                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                        <Spinner
                            android:id="@+id/spToStore"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_input_field"
                            android:paddingHorizontal="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Product & Quantity Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:orientation="vertical"
                        android:layout_marginEnd="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Product"
                                android:textColor="@color/text_primary"

                                android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                            <TextView
                                android:id="@+id/tvAvailableStock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Stock: —"
                                android:textColor="@color/primary"

                                android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
                        </LinearLayout>

                        <Spinner
                            android:id="@+id/spTransferProduct"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_input_field"
                            android:paddingHorizontal="8dp"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to select from source store's inventory"
                            android:textColor="@color/text_muted"

                            android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quantity"
                            android:textColor="@color/text_primary"

                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                        <EditText
                            android:id="@+id/etTransferQuantity"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input_field"
                            android:hint="Qty"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"

                            android:inputType="number"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:cursorVisible="true"
                            android:importantForAutofill="no"
                            android:paddingHorizontal="12dp"  android:textAppearance="@style/TextAppearance.StockEase.Body" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Multi-select: add the chosen product to the request -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddTransferItem"
                    style="@style/Widget.StockEase.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:text="+ Add item to request"
                    android:textAllCaps="false"
                    android:textColor="@color/slate_600"
                    android:textAppearance="@style/TextAppearance.StockEase.Label" />

                <TextView
                    android:id="@+id/tvSelectedItemsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Requested items (0)"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"
                    android:textAppearance="@style/TextAppearance.StockEase.Label" />

                <LinearLayout
                    android:id="@+id/llSelectedItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp" />

                <!-- Notes Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notes / Reason (Optional)"
                    android:textColor="@color/text_primary"

                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                <EditText
                    android:id="@+id/etTransferNotes"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="e.g. Replenishment for upcoming weekend promotion"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"

                    android:singleLine="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:cursorVisible="true"
                    android:importantForAutofill="no"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="16dp"  android:textAppearance="@style/TextAppearance.StockEase.Body" />

                <!-- Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitTransfer"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Create Transfer"

                    android:textColor="@color/white"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="0dp"  android:textAppearance="@style/TextAppearance.StockEase.Body" style="@style/Widget.StockEase.Button.Primary" />
            </LinearLayout>

            <!-- Transfer History Data Table Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Transfer History"
                        android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Section" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefreshTransfers"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Refresh"

                        android:textColor="@color/slate_600"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="0dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Secondary" />
                </LinearLayout>

                <!-- Data Table Header (44dp height) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@color/app_background">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:text="#"
                        android:textColor="@color/text_secondary"

                        android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2.0"
                        android:text="ROUTE"
                        android:textColor="@color/text_secondary"

                        android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:gravity="end"
                        android:text="QTY"
                        android:textColor="@color/text_secondary"

                        android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="REQUESTED BY"
                        android:textColor="@color/text_secondary"

                        android:textStyle="bold"
                        android:paddingStart="8dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="DATE"
                        android:textColor="@color/text_secondary"

                        android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:gravity="center"
                        android:text="STATUS"
                        android:textColor="@color/text_secondary"

                        android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:gravity="center"
                        android:text="ACTIONS"
                        android:textColor="@color/text_secondary"

                        android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_border" />

                <!-- Empty / Loading Status -->
                <TextView
                    android:id="@+id/tvTransfersStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading transfers..."
                    android:textColor="@color/text_secondary"

                    android:gravity="center"
                    android:padding="32dp"  android:textAppearance="@style/TextAppearance.StockEase.Body" />

                <!-- Dynamic Transfer Rows -->
                <LinearLayout
                    android:id="@+id/llTransferRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
    </LinearLayout>

</LinearLayout>
