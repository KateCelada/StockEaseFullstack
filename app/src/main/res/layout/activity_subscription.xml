<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0F172A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnSubBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="Back"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="StockEase Subscription"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubHeaderBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_emerald"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Active Plan"
            android:textColor="#059669"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Section 1: Current Plan Overview Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT PLAN DETAILS"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvCurrentPlanTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="StockEase Free"
                        android:textColor="#0F172A"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCurrentStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_gray"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="Active"
                        android:textColor="#334155"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#F8FAFC"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Billing Interval"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvBillingPeriod"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="None (Free)"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#E2E8F0"
                        android:layout_marginHorizontal="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Renewal / Expiration"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvExpirationDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No expiration"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPlanAccessSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Standard operational access: POS checkout, local product and inventory tracking, and sales history."
                    android:textColor="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Section 2: Plans Comparison -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVAILABLE TIERS"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Tier 1: Free -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FREE"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱0"
                        android:textColor="#0F172A"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginVertical="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Standard retail store operations."
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginBottom="10dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Full POS Checkout" android:textColor="#334155" android:textSize="12sp" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Inventory Management" android:textColor="#334155" android:textSize="12sp" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Low Stock Alerts" android:textColor="#334155" android:textSize="12sp" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Staff Accounts" android:textColor="#334155" android:textSize="12sp" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Standard Sales Reports" android:textColor="#334155" android:textSize="12sp" />
                </LinearLayout>

                <!-- Tier 2: Premium Monthly -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PREMIUM MONTHLY"
                        android:textColor="#2563EB"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱699 / mo"
                        android:textColor="#0F172A"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginVertical="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full multi-branch control &amp; analytics."
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginBottom="10dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Everything in Free" android:textColor="#334155" android:textSize="12sp" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Multi-Store Stock Transfers" android:textColor="#2563EB" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ StockEase Insights" android:textColor="#2563EB" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Transfer Recommendations" android:textColor="#2563EB" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Multi-Store Comparison" android:textColor="#2563EB" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnApplyMonthly"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_btn_primary"
                        android:text="Apply (₱699/mo)"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tier 3: Premium Yearly (Value Option) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PREMIUM YEARLY"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_emerald"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="BEST VALUE"
                            android:textColor="#059669"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱6,990 / yr"
                        android:textColor="#0F172A"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save ₱1,398 vs monthly billing"
                        android:textColor="#059669"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginBottom="10dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Everything in Monthly" android:textColor="#334155" android:textSize="12sp" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ 1 Full Year Coverage" android:textColor="#059669" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Priority System Reports" android:textColor="#334155" android:textSize="12sp" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓ Uninterrupted Operations" android:textColor="#334155" android:textSize="12sp" android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnApplyYearly"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_btn_emerald"
                        android:text="Apply (₱6,990/yr)"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
