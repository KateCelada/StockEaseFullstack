<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <!-- Header Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sidebar_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transaction Audit Register"
                    android:textColor="@color/white"

  android:textAppearance="@style/TextAppearance.StockEase.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Audit on-duty cashiers, search orders, and void errors"
                    android:textColor="@color/text_muted"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportCsv"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Export CSV"
  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTotalRevenue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="₱0.00"
            android:textColor="@color/success"

  android:textAppearance="@style/TextAppearance.StockEase.Title" />
    </LinearLayout>

    <!-- Search & Cashier/Status Filter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/card_background"
        android:gravity="center_vertical">

        <!-- Search input for transaction ID, customer, item, or cashier name -->
        <EditText
            android:id="@+id/etSearchTransactions"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="Search ID, item, or cashier name..."
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"

            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

        <!-- Status Filter Dropdown -->
        <Spinner
            android:id="@+id/spinnerFilterStatus"
            android:layout_width="130dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_input_field" />
    </LinearLayout>

    <!-- Date Filter Button Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:scrollbars="none"
        android:background="@color/card_subtle_bg">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:text="All Dates"
  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterToday"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:text="Today"
  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterMonth"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:text="This Month"
  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterCustom"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Custom Range"
  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Secondary" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Table Header Legend -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="@color/card_border">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="TRANS # / ON-DUTY CASHIER"

            android:textStyle="bold"
            android:textColor="@color/slate_600"  android:textAppearance="@style/TextAppearance.StockEase.Caption" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATUS / AMOUNT"

            android:textStyle="bold"
            android:gravity="end"
            android:textColor="@color/slate_600"  android:textAppearance="@style/TextAppearance.StockEase.Caption" />
    </LinearLayout>

    <!-- Transaction List Table -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTransactions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="4dp" />

        <include
            android:id="@+id/loadingTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible"
            layout="@layout/view_loading_state" />

        <include
            android:id="@+id/emptyTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            layout="@layout/view_empty_state" />
    </FrameLayout>

</LinearLayout>