<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sales &amp; Transactions"
        android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Title" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Branch transaction history"
        android:textColor="@color/text_secondary"

        android:layout_marginBottom="16dp"  android:textAppearance="@style/TextAppearance.StockEase.Body" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTransactions"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>