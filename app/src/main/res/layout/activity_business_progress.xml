<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/sidebar_bg"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <ImageButton
            android:id="@+id/btnProgressBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_nav_dashboard"
            android:tint="#FFFFFF"
            android:layout_marginEnd="12dp"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProgressTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Business Progress"
                android:textColor="@color/white"

  android:textAppearance="@style/TextAppearance.StockEase.Title" />

            <TextView
                android:id="@+id/tvProgressSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real-time sales &amp; performance metrics"
                android:textColor="@color/text_muted"

                android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProgressRefresh"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Refresh"

            android:textColor="@color/white"
            android:paddingHorizontal="16dp"
            android:paddingVertical="0dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Filter Tabs Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Period:"
                    android:textColor="@color/text_secondary"

                    android:textStyle="bold"
                    android:layout_marginEnd="12dp"  android:textAppearance="@style/TextAppearance.StockEase.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterToday"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Today"

                    android:textColor="@color/slate_600"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="0dp"
                    android:layout_marginEnd="8dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterWeek"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="This Week"

                    android:textColor="@color/white"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="0dp"
                    android:layout_marginEnd="8dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="This Month"

                    android:textColor="@color/slate_600"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="0dp"
                    android:layout_marginEnd="8dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Custom"

                    android:textColor="@color/slate_600"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="0dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Secondary" />
            </LinearLayout>

            <!-- Metrics Summary Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <!-- Card 1: Total Revenue -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_white"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Revenue"
                        android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:id="@+id/tvMetricTotalSales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱0.00"


                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Title" />
                </LinearLayout>

                <!-- Card 2: Orders -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_white"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transactions"
                        android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:id="@+id/tvMetricTransactions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"


                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Title" />
                </LinearLayout>

                <!-- Card 3: Items Sold -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_white"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Items Sold"
                        android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:id="@+id/tvMetricProductsSold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"


                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Title" />
                </LinearLayout>

                <!-- Card 4: Net Profit -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_white"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Net Profit"
                        android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:id="@+id/tvMetricNetProfit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱0.00"


                        android:textColor="@color/success"
                        android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Title" />
                </LinearLayout>
            </LinearLayout>

            <!-- Line Chart Flashcard -->
            <LinearLayout
                android:id="@+id/cardLineChartContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sales Progress Trend"
                            android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Section" />

                        <TextView
                            android:id="@+id/tvChartHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap chart to inspect detailed breakdown"
                            android:textColor="@color/primary"

                            android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvChartDateRange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This Week"
                        android:textColor="@color/text_secondary"

                        android:background="@drawable/bg_pill_header"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
                </LinearLayout>

                <com.example.stockease.SimpleLineChartView
                    android:id="@+id/progressLineChart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Section 1: Branch Contribution / Top Selling Products -->
            <LinearLayout
                android:id="@+id/containerSectionOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvSectionOneTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Branch Contribution Breakdown"
                        android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Section" />

                    <TextView
                        android:id="@+id/tvSectionOneBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real-time"
                        android:textColor="@color/primary_ink"

                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_blue"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llSectionOneRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Section 2: Store Accounts Roster (for Store/Branch mode) -->
            <LinearLayout
                android:id="@+id/containerSectionTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Store Accounts &amp; Roles"
                        android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Section" />

                    <TextView
                        android:id="@+id/tvAccountsCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Accounts"
                        android:textColor="@color/success_strong"

                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_emerald"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llSectionTwoRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
