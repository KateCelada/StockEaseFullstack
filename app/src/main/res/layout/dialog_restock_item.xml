<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDialogRestockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Restock Product"
        android:textColor="#1B1C30"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDialogRestockSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Stock: 3 units | Par Level: 30 units"
        android:textColor="#6E7191"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quantity to Add"
        android:textColor="#1B1C30"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etRestockQuantity"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#F5F6FA"
        android:paddingHorizontal="14dp"
        android:inputType="number"
        android:textColor="#1B1C30"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogRestockCancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="#6E7191"
            android:backgroundTint="#F5F6FA"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnDialogRestockConfirm"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="Confirm Restock"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7C4DFF"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
