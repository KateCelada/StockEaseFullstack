<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Product Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCartProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvCartPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textSize="13sp"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Quantity Stepper Controls (- QTY +) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F1F3F4"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:id="@+id/btnDecreaseQty"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_input_add"
                android:rotation="45"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#D32F2F"
                android:contentDescription="Decrease quantity" />

            <TextView
                android:id="@+id/tvCartQuantity"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#111111" />

            <ImageButton
                android:id="@+id/btnIncreaseQty"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_input_add"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#1B5E20"
                android:contentDescription="Increase quantity" />
        </LinearLayout>

        <!-- Delete Item Button -->
        <ImageButton
            android:id="@+id/btnRemoveCartItem"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#C62828"
            android:contentDescription="Remove item" />

    </LinearLayout>
</androidx.cardview.widget.CardView>