<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Register New Store"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etDialogStoreName"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_input_field"
        android:hint="Store Branch Name (e.g. Northern Branch)"
        android:textColorHint="#94A3B8"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etDialogLocation"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_input_field"
        android:hint="Location / Address"
        android:textColorHint="#94A3B8"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Cancel"
            style="?attr/borderlessButtonStyle"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSaveStore"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Save Store"
            android:textSize="13sp"
            android:backgroundTint="@color/primary"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>