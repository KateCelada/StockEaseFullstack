<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable password strength meter. Include it directly below any password
     field and wire it with PasswordStrength.bind(root, passwordField). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <ProgressBar
        android:id="@+id/pwStrengthProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:max="100"
        android:progress="0"
        tools:progress="60" />

    <TextView
        android:id="@+id/pwStrengthLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="12sp"
        android:textColor="#64748B"
        tools:text="Password strength: Fair" />

</LinearLayout>
