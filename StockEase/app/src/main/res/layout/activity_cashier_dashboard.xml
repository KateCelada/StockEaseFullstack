<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/app_background">

    <!-- Left Navigation Sidebar -->
    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:background="@color/sidebar_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- App Brand Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_btn_primary"
                android:text="S"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_marginEnd="12dp"  android:textAppearance="@style/TextAppearance.StockEase.Section" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="StockEase"
                android:textColor="@color/white"
android:textAppearance="@style/TextAppearance.StockEase.Title" />
        </LinearLayout>

        <!-- Sidebar Navigation Items -->

        <!-- SECTION HEADER: OVERVIEW -->
        <LinearLayout
            android:id="@+id/navHeaderOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OVERVIEW"
                android:letterSpacing="0.08"
                android:textColor="@color/sidebar_text"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />

            <TextView
                android:id="@+id/navArrowOverview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sidebar_text"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSectionOverviewItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp">

        <LinearLayout
            android:id="@+id/navStaffDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_primary"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_nav_dashboard_white"
                android:layout_marginEnd="12dp"  android:contentDescription="@string/cd_nav_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textColor="@color/white"
                android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Body" />
        </LinearLayout>

        </LinearLayout>

        <!-- SECTION HEADER: MANAGEMENT -->
        <LinearLayout
            android:id="@+id/navHeaderManagement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MANAGEMENT"
                android:letterSpacing="0.08"
                android:textColor="@color/sidebar_text"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />

            <TextView
                android:id="@+id/navArrowManagement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sidebar_text"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSectionManagementItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp">

        <LinearLayout
            android:id="@+id/navStaffPOS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_nav_sales"
                android:layout_marginEnd="12dp"  android:contentDescription="@string/cd_nav_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POS"
                android:textColor="@color/sidebar_text"
android:textAppearance="@style/TextAppearance.StockEase.Body" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStaffShift"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_nav_inventory"
                android:layout_marginEnd="12dp"  android:contentDescription="@string/cd_nav_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Shift"
                android:textColor="@color/sidebar_text"
android:textAppearance="@style/TextAppearance.StockEase.Body" />
        </LinearLayout>

        </LinearLayout>

        <!-- SECTION HEADER: ANALYTICS -->
        <LinearLayout
            android:id="@+id/navHeaderAnalytics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ANALYTICS"
                android:letterSpacing="0.08"
                android:textColor="@color/sidebar_text"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />

            <TextView
                android:id="@+id/navArrowAnalytics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sidebar_text"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSectionAnalyticsItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp">

        <LinearLayout
            android:id="@+id/navStaffTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_nav_reports"
                android:layout_marginEnd="12dp"  android:contentDescription="@string/cd_nav_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transactions"
                android:textColor="@color/sidebar_text"
android:textAppearance="@style/TextAppearance.StockEase.Body" />
        </LinearLayout>

        </LinearLayout>

        <!-- SYSTEM section removed for staff accounts (Settings is admin-only) -->

        <!-- Bottom User Profile & Logout -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tvStaffAvatarInitials"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:text="AC"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginEnd="12dp"  android:textAppearance="@style/TextAppearance.StockEase.Body" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStaffProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ana Cruz"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:singleLine="true"  android:textAppearance="@style/TextAppearance.StockEase.Body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Staff"
                    android:textColor="@color/sidebar_text"
android:textAppearance="@style/TextAppearance.StockEase.Label" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/sidebar_divider" />

        <LinearLayout
            android:id="@+id/navStaffLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_nav_logout"
                android:layout_marginEnd="12dp"  android:contentDescription="@string/cd_nav_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log out"
                android:textColor="@color/sidebar_text"
android:textAppearance="@style/TextAppearance.StockEase.Body" />
        </LinearLayout>

    </LinearLayout>

    <!-- Main Content Area -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCashierStaffName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome, Ana"
                        android:textColor="@color/text_primary"
android:textAppearance="@style/TextAppearance.StockEase.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ready to make sales today?"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Body" />
                </LinearLayout>

                <!-- Store Selector Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_header"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:id="@+id/tvCashierHeaderStorePill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Store"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_muted"
android:textAppearance="@style/TextAppearance.StockEase.Caption" />
                </LinearLayout>

                <!-- Date Picker Box -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_header"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today"
                            android:textColor="@color/text_secondary"
android:textAppearance="@style/TextAppearance.StockEase.Label" />

                        <TextView
                            android:id="@+id/tvCashierHeaderDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sep 26, 2026"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_muted"
android:textAppearance="@style/TextAppearance.StockEase.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2 Stat Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <!-- Card 1: Today's Shift Sales -->
                <LinearLayout
                    android:id="@+id/cardCashierShiftSales"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_white"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's Sales"
                        android:textColor="@color/text_secondary"
android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:id="@+id/tvCashierShiftSales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱0.00"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Title" />

                    <TextView
                        android:id="@+id/tvCashierShiftSalesTrend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:visibility="gone"
                        android:textAppearance="@style/TextAppearance.StockEase.Label" />
                </LinearLayout>

                <!-- Card 2: Shift Transactions -->
                <LinearLayout
                    android:id="@+id/cardCashierShiftTx"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_white"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transactions"
                        android:textColor="@color/text_secondary"
android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:id="@+id/tvCashierShiftTxCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Title" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hero Start POS Button with Shopping Cart Icon -->
            <LinearLayout
                android:id="@+id/btnOpenPOS"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_primary"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_cart_white"
                    android:layout_marginEnd="12dp"  android:contentDescription="@string/cd_nav_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start POS"
                    android:textColor="@color/white"
android:textAppearance="@style/TextAppearance.StockEase.Section" />
            </LinearLayout>

            <!-- My Shift Summary Card -->
            <LinearLayout
                android:id="@+id/cardShiftSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="My Shift Summary"
                        android:textColor="@color/text_primary"
android:textAppearance="@style/TextAppearance.StockEase.Section" />

                    <TextView
                        android:id="@+id/btnCashierShiftSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View Details"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
                </LinearLayout>

                <!-- Shift control: status badge + auto-start notice (no Start button) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvShiftStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_gray"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="OFF DUTY"
                        android:textColor="@color/slate_700"
                        android:textStyle="bold"
                        android:layout_marginEnd="12dp"
                        android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:id="@+id/tvShiftAutoNote"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="Your shift starts automatically the first time you log in for the day."
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.StockEase.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Shift Start -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shift Start"
                            android:textColor="@color/text_secondary"
android:textAppearance="@style/TextAppearance.StockEase.Label" />

                        <TextView
                            android:id="@+id/tvShiftStartTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="08:00 AM"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Body" />
                    </LinearLayout>

                    <!-- Current Time -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Time"
                            android:textColor="@color/text_secondary"
android:textAppearance="@style/TextAppearance.StockEase.Label" />

                        <TextView
                            android:id="@+id/tvShiftLastTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="04:52 PM"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Body" />
                    </LinearLayout>

                    <!-- Total Sales -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Sales"
                            android:textColor="@color/text_secondary"
android:textAppearance="@style/TextAppearance.StockEase.Label" />

                        <TextView
                            android:id="@+id/tvShiftTotalSalesSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱0.00"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Body" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Recent Transactions Table Card -->
            <LinearLayout
                android:id="@+id/cardCashierRecentSales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recent Transactions"
                        android:textColor="@color/text_primary"
android:textAppearance="@style/TextAppearance.StockEase.Section" />

                    <TextView
                        android:id="@+id/tvCashierRefresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View All"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCashierRecentSales"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tvCashierEmptySales"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="center"
                        android:text="No transactions processed yet on this shift.\nTap 'Start POS' above to begin selling."
                        android:textColor="@color/text_muted"
                        android:visibility="gone"  android:textAppearance="@style/TextAppearance.StockEase.Body" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>