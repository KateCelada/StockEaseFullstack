<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTxId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="#1056"
            android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Section" />

        <TextView
            android:id="@+id/tvTxStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="8dp"
            android:text="COMPLETED"

            android:textStyle="bold"
            android:textColor="@color/success_text"
            android:background="@color/success_bg"  android:textAppearance="@style/TextAppearance.StockEase.Caption" />

        <TextView
            android:id="@+id/tvTxTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱0.00"
            android:textColor="@color/success"

  android:textAppearance="@style/TextAppearance.StockEase.Section" />
    </LinearLayout>

    <!-- Cashier & Payment Type -->
    <TextView
        android:id="@+id/tvTxMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Cashier: Main Cashier • Cash"
        android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

    <!-- Date & Time -->
    <TextView
        android:id="@+id/tvTxDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="2026-09-26 09:22:00"
        android:textColor="@color/text_muted"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/card_border" />

    <!-- Summary of items purchased -->
    <TextView
        android:id="@+id/tvTxSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1x Item Description"
        android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

    <!-- Action Row (Void Button) -->
    <LinearLayout
        android:id="@+id/layoutTxActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVoidTx"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Void Transaction"

            android:textColor="@color/danger_strong"
            android:background="@color/danger_bg"
            android:paddingHorizontal="12dp"
            style="?attr/borderlessButtonStyle"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
    </LinearLayout>

</LinearLayout>