<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Product Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCartProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product Name"


                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:maxLines="1"  android:textAppearance="@style/TextAppearance.StockEase.Section" />

            <TextView
                android:id="@+id/tvCartPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"

                android:textColor="@color/success_text"
                android:textStyle="bold"
                android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Body" />
        </LinearLayout>

        <!-- Quantity Stepper Controls (- QTY +) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/card_subtle_bg"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:id="@+id/btnDecreaseQty"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_input_add"
                android:rotation="45"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/danger_strong"
                android:contentDescription="@string/cart_dec_cd" />

            <TextView
                android:id="@+id/tvCartQuantity"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="1"

                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/text_primary"  android:textAppearance="@style/TextAppearance.StockEase.Body" />

            <ImageButton
                android:id="@+id/btnIncreaseQty"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_input_add"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/success_strong"
                android:contentDescription="@string/cart_inc_cd" />
        </LinearLayout>

        <!-- Delete Item Button -->
        <ImageButton
            android:id="@+id/btnRemoveCartItem"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/danger_strong"
            android:contentDescription="@string/cart_remove_cd" />

    </LinearLayout>
</androidx.cardview.widget.CardView>