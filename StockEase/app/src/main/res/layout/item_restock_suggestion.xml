<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_background"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Top Row: Name and Urgency Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvRestockProductName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Product Name"
            android:textColor="@color/text_primary"

  android:textAppearance="@style/TextAppearance.StockEase.Section" />

        <TextView
            android:id="@+id/tvRestockUrgencyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CRITICAL"
            android:textColor="@color/danger_strong"
            android:background="@color/danger_bg"
            android:textStyle="bold"

            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />
    </LinearLayout>

    <!-- Category -->
    <TextView
        android:id="@+id/tvRestockCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category: General"
        android:textColor="@color/text_secondary"

        android:layout_marginBottom="16dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" />

    <!-- Metrics Grid / Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/app_background"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <!-- Current Stock -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Stock"
                android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

            <TextView
                android:id="@+id/tvRestockCurrentStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:textColor="@color/danger_strong"


                android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Section" />
        </LinearLayout>

        <!-- Target Par Level -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target Par"
                android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

            <TextView
                android:id="@+id/tvRestockTargetPar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:textColor="@color/text_primary"


                android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Section" />
        </LinearLayout>

        <!-- Suggested Reorder -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suggested Reorder"
                android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

            <TextView
                android:id="@+id/tvRestockSuggestedQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:textColor="@color/success_text"


                android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Section" />
        </LinearLayout>

        <!-- Estimated Cost -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Est. Cost"
                android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

            <TextView
                android:id="@+id/tvRestockEstCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:textColor="@color/brand_accent"


                android:layout_marginTop="4dp"  android:textAppearance="@style/TextAppearance.StockEase.Section" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvRestockUnitPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:textColor="@color/text_secondary"
  android:textAppearance="@style/TextAppearance.StockEase.Label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestockAction"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Restock Now"
            android:textColor="@color/white"

            android:paddingHorizontal="16dp"
            android:paddingVertical="0dp"  android:textAppearance="@style/TextAppearance.StockEase.Label" style="@style/Widget.StockEase.Button.Primary" />
    </LinearLayout>

</LinearLayout>
