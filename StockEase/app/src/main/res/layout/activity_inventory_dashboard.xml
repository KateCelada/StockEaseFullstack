<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/app_background">

    <!-- Left Navigation Sidebar -->
    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:background="@color/sidebar_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- App Brand Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_btn_primary"
                android:text="S"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_marginEnd="12dp"
                android:textAppearance="@style/TextAppearance.StockEase.Section" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="StockEase"
                android:textColor="@color/white"
                android:textAppearance="@style/TextAppearance.StockEase.Title" />
        </LinearLayout>

        <!-- SECTION HEADER: OVERVIEW -->
        <LinearLayout
            android:id="@+id/navHeaderOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OVERVIEW"
                android:letterSpacing="0.08"
                android:textColor="@color/sidebar_text"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />

            <TextView
                android:id="@+id/navArrowOverview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sidebar_text"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSectionOverviewItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:id="@+id/navInvDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_primary"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_dashboard_white"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/cd_nav_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dashboard"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textAppearance="@style/TextAppearance.StockEase.Body" />
            </LinearLayout>
        </LinearLayout>

        <!-- SECTION HEADER: MANAGEMENT -->
        <LinearLayout
            android:id="@+id/navHeaderManagement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MANAGEMENT"
                android:letterSpacing="0.08"
                android:textColor="@color/sidebar_text"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />

            <TextView
                android:id="@+id/navArrowManagement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sidebar_text"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSectionManagementItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:id="@+id/navInvProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_products"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/cd_nav_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inventory &amp; Products"
                    android:textColor="@color/sidebar_text"
                    android:textAppearance="@style/TextAppearance.StockEase.Body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navInvTransfers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_sales"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/cd_nav_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transfers"
                    android:textColor="@color/sidebar_text"
                    android:textAppearance="@style/TextAppearance.StockEase.Body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navInvShift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_inventory"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/cd_nav_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Shift"
                    android:textColor="@color/sidebar_text"
                    android:textAppearance="@style/TextAppearance.StockEase.Body" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/sidebar_divider" />

        <LinearLayout
            android:id="@+id/navInvLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_nav_settings"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/cd_nav_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log out"
                android:textColor="@color/sidebar_text"
                android:textAppearance="@style/TextAppearance.StockEase.Body" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvInvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome, Inventory Staff"
                        android:textColor="@color/text_primary"
                        android:textAppearance="@style/TextAppearance.StockEase.Title" />

                    <TextView
                        android:id="@+id/tvInvBranchPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Branch"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.StockEase.Label" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvInvAvatarInitials"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@color/primary"
                    android:gravity="center"
                    android:text="IN"
                    android:textColor="@color/white"
                    android:textAppearance="@style/TextAppearance.StockEase.Section" />
            </LinearLayout>

            <!-- Shift Control Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MY SHIFT"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:textAppearance="@style/TextAppearance.StockEase.Label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvInvShiftStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_gray"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="OFF DUTY"
                        android:textColor="@color/slate_700"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.StockEase.Label" />

                    <TextView
                        android:id="@+id/tvInvShiftStartedAt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="No active shift"
                        android:textColor="@color/text_muted"
                        android:textAppearance="@style/TextAppearance.StockEase.Label" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInvShiftToggle"
                    style="@style/Widget.StockEase.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Start Shift"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textAppearance="@style/TextAppearance.StockEase.Label" />
            </LinearLayout>

            <!-- Quick Actions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUICK ACTIONS"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:textAppearance="@style/TextAppearance.StockEase.Label" />

            <LinearLayout
                android:id="@+id/cardInvProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_nav_products"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@string/cd_nav_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inventory &amp; Products"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.StockEase.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manage products, stock levels and restocks"
                        android:textColor="@color/text_muted"
                        android:textAppearance="@style/TextAppearance.StockEase.Label" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardInvTransfers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_nav_sales"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@string/cd_nav_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stock Transfers"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.StockEase.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Request stock from a sister branch"
                        android:textColor="@color/text_muted"
                        android:textAppearance="@style/TextAppearance.StockEase.Label" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
